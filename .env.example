# ── LLM provider ──────────────────────────────────────────────────────────
# Any OpenAI-compatible provider. First match wins.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# OPENJEV_MODEL=gpt-4o-mini

# ── Mapika/decider backend (mode: "decider") ─────────────────────────────
# DECIDER_BASE_URL=http://localhost:8000
# DECIDER_API_KEY=local

# ── Calibration (fit with `npm run calibrate`) ───────────────────────────
# Softmax temperature; 1 = no rescaling.
# OPENJEV_CALIBRATION_T=1

# ── Readout / performance ────────────────────────────────────────────────
# Parallel readout: logprob (one call per question) | micro (one per option)
# OPENJEV_PARALLEL_MODE=logprob
# Max in-flight LLM calls per request / script run (default 6)
# OPENJEV_CONCURRENCY=6
# Per-call timeout for the OpenAI SDK (ms, default 30000)
# OPENJEV_TIMEOUT_MS=30000
# Retry attempts for transient failures (default 3)
# OPENJEV_MAX_RETRIES=3

# ── API hardening ────────────────────────────────────────────────────────
# Comma-separated bearer keys for /api/evaluate. UNSET = open API (dev only).
# OPENJEV_API_KEYS=key1,key2
# Requests per window per IP; "off" disables. Default 60.
# OPENJEV_RATE_LIMIT=60
# OPENJEV_RATE_WINDOW_MS=60000

# ── Server ───────────────────────────────────────────────────────────────
# PORT=3001
# NODE_ENV=production
# Log level: debug | info | warn | error
# OPENJEV_LOG_LEVEL=info
