# OpenJev — copy to .env and fill in

# Required: at least one provider key
# OPENAI_API_KEY=sk-...
# CEREBRAS_API_KEY=csk-...
# PUTER_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENJEV_API_KEY=...

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENJEV_BASE_URL=https://api.cerebras.ai/v1
# OPENJEV_MODEL=gpt-4o-mini
# PORT=3001

# Comma-separated browser origins allowed to read API responses.
# Unset or empty: no cross-origin browser access. The same-origin UI still works.
# * is not a wildcard. Match the origin the browser sends, including scheme and port.
# CORS_ALLOWED_ORIGINS=
